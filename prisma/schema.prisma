generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SiteSetting {
  id       String   @id @default(cuid())
  key      String   @unique
  value    String
  type     String   @default("text") // "color", "font", "size", "text", "image", "boolean"
  category String   @default("global") // "global", "hero", "about", "footer", "contact"
  label    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  isDropdown Boolean @default(false)
  parent   String?  // if this is a sub-item, reference parent id
  iconName String   @default("") // Lucide icon name for display in nav
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InsurancePage {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  tagline           String
  description       String
  features          String   @default("[]") // JSON array of strings
  tip               String   @default("")
  iconColor         String   @default("#0033A0")
  iconBgColor       String   @default("#e8edf5")
  iconName          String   @default("Shield") // Lucide icon name
  order             Int      @default(0)
  visible           Boolean  @default(true)
  // Banner & Appearance
  bannerImage       String   @default("") // URL for banner background image
  bannerColorFrom   String   @default("") // Gradient start color for banner
  bannerColorTo     String   @default("") // Gradient end color for banner
  backgroundColor   String   @default("") // Section background color
  cardAccentColor   String   @default("") // Accent color for cards/highlights
  textColor         String   @default("") // Override text color
  // Banner Text & Buttons
  bannerTextPosition String  @default("center") // "left", "center", "right"
  bannerCta1Text    String   @default("Call for a Quote") // First CTA button text
  bannerCta1Color   String   @default("#ff9e16") // First CTA button color
  bannerCta1Link    String   @default("tel:+16107259900") // First CTA button link
  bannerCta2Text    String   @default("Request Online") // Second CTA button text
  bannerCta2Color   String   @default("") // Second CTA button color (empty = outline style)
  bannerCta2Link    String   @default("/") // Second CTA button link
  // Image positioning & sizing
  bannerImagePosition String @default("center center") // CSS background-position
  bannerImageSize   String   @default("cover") // CSS background-size
  bannerTitleSize   Int      @default(52) // Banner title font size in px
  // Emoji
  emoji             String   @default("") // Emoji for display in cards/nav
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PageSection {
  id          String   @id @default(cuid())
  section     String   @unique // "hero", "about", "whyChooseUs", "testimonials", "faq", "contact", "ctaBanner"
  title       String
  subtitle    String   @default("")
  description String   @default("")
  content     String   @default("{}") // JSON for additional structured content
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Float    @default(5.0)
  text      String
  date      String   @default("")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentInfo {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  label        String   @default("")
  type         String   @default("text") // "text", "phone", "email", "url", "image"
  editable     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
